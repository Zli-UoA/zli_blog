---
import { Image } from "astro:assets";
import { type CollectionEntry, getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import PostCard from "../../components/PostCard.astro";
import { SITE_TITLE } from "../../consts";

export async function getStaticPaths() {
  const authors = await getCollection("authors");
  const posts = await getCollection("posts");

  return authors.map((author) => {
    // Find posts by this author
    const authorPosts = posts
      .filter((post) => post.data.authors.some((a) => a.id === author.data.id))
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

    return {
      params: { author: author.data.id },
      props: { author, posts: authorPosts },
    };
  });
}

type Props = {
  author: CollectionEntry<"authors">;
  posts: CollectionEntry<"posts">[];
};

const { author, posts } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead
      title={`${author.data.displayName} - ${SITE_TITLE}`}
      description={author.data.bio}
    />
  </head>
  <body>
    <Header />
    <main class="max-w-5xl mx-auto py-8 px-4">
      <div
        class="flex flex-col items-center text-center mb-12 p-8 bg-white rounded-xl shadow-sm border border-gray-200"
      >
        <Image
          class="w-32 h-32 rounded-full object-cover mb-4"
          src={author.data.icon}
          alt={author.data.displayName}
          width={128}
          height={128}
        />
        <h1 class="text-3xl m-0 mb-4">{author.data.displayName}</h1>
        <p
          class="text-slate-700 leading-relaxed whitespace-pre-line max-w-xl m-0"
        >
          {author.data.bio}
        </p>
      </div>

      <section>
        <h2 class="mb-6 text-2xl">投稿記事</h2>
        {
          posts.length > 0 ? (
            <ul class="grid grid-cols-1 md:grid-cols-2 gap-8 list-none m-0 p-0">
              {posts.map((post) => (
                <li>
                  <PostCard post={post} />
                </li>
              ))}
            </ul>
          ) : (
            <p class="text-slate-500 text-center p-8">まだ投稿がありません</p>
          )
        }
      </section>
    </main>
    <Footer />
  </body>
</html>
