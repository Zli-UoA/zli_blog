---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import placeholderImage from "../assets/placeholder.png";

const posts = (await getCollection("posts")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const latestPost = posts[0];
const recentPosts = posts.slice(1, 5);
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main class="w-full max-w-5xl mx-auto py-12 px-4">
      <!-- ヒーローセクション -->
      <section class="text-center mb-16">
        <h1 class="text-5xl md:text-6xl font-bold mb-4 text-slate-900">
          {SITE_TITLE}
        </h1>
        <p class="text-xl text-slate-600 max-w-2xl mx-auto">
          {SITE_DESCRIPTION}
        </p>
      </section>

      <!-- 最新の投稿 -->
      {
        latestPost && (
          <section class="mb-16">
            <h2 class="text-3xl font-bold mb-8 text-slate-900">最新の投稿</h2>
            <a
              href={`/posts/${latestPost.id}/`}
              class="block no-underline transition-all duration-200 group"
            >
              <div class="relative overflow-hidden rounded-2xl">
                <Image
                  width={1020}
                  height={510}
                  src={latestPost.data.heroImage ?? placeholderImage}
                  alt=""
                  class="w-full h-auto aspect-video object-cover transition-all duration-300 group-hover:scale-105"
                />
                <div class="absolute inset-0 bg-linear-to-t from-black/60 to-transparent" />
                <div class="absolute bottom-0 left-0 right-0 p-8 text-white">
                  <p class="text-sm opacity-80 mb-2">
                    <FormattedDate date={latestPost.data.pubDate} />
                  </p>
                  <h3 class="text-3xl md:text-4xl font-bold m-0 text-white group-hover:text-accent">
                    {latestPost.data.title}
                  </h3>
                  <p class="mt-2 text-lg opacity-90 line-clamp-2">
                    {latestPost.data.description}
                  </p>
                </div>
              </div>
            </a>
          </section>
        )
      }

      <!-- 最近の投稿 -->
      {
        recentPosts.length > 0 && (
          <section class="mb-16">
            <div class="flex justify-between items-center mb-8">
              <h2 class="text-3xl font-bold text-slate-900 m-0">最近の投稿</h2>
              <a
                href="/posts/"
                class="text-amber-600 hover:text-amber-700 font-medium no-underline"
              >
                すべての投稿を見る →
              </a>
            </div>
            <ul class="grid grid-cols-1 md:grid-cols-2 gap-8 list-none m-0 p-0">
              {recentPosts.map((post) => {
                const heroImage = post.data.heroImage ?? placeholderImage;
                return (
                  <li>
                    <a
                      href={`/posts/${post.id}/`}
                      class="block no-underline transition-all duration-200 group"
                    >
                      <Image
                        width={720}
                        height={360}
                        src={heroImage}
                        alt=""
                        class="mb-3 rounded-xl w-full h-auto aspect-video object-cover transition-all duration-200 group-hover:-translate-y-1 group-hover:shadow-lg"
                      />
                      <h4 class="m-0 text-slate-900 leading-snug group-hover:text-accent-dark text-xl">
                        {post.data.title}
                      </h4>
                      <p class="mt-2 mb-0 text-slate-500 text-sm">
                        <FormattedDate date={post.data.pubDate} />
                      </p>
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        )
      }

      <!-- CTAセクション -->
      <section class="bg-brand-black rounded-2xl p-8 md:p-12 text-center">
        <h2 class="text-2xl md:text-3xl font-bold text-brand-white mb-4">
          Zliについてもっと知る
        </h2>
        <p class="text-brand-white mb-6 max-w-xl mx-auto">
          Zliは、技術好きが集まる総合技術系サークルです。私たちの公式サイトで、最新のプロジェクトやイベント情報をチェックしてください！
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href="https://zli.works/"
            class="inline-block px-6 py-3 bg-accent text-brand-black font-semibold rounded-lg no-underline hover:bg-accent-dark transition-colors"
          >
            Zli公式サイトへ →
          </a>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
