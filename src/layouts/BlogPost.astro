---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import TagBadge from "../components/TagBadge.astro";

type Props = Omit<CollectionEntry<"posts">["data"], "authors" | "tags"> & {
  authors: CollectionEntry<"authors">[];
  tags: CollectionEntry<"tags">[];
};

const { title, description, pubDate, updatedDate, heroImage, authors, tags } =
  Astro.props;
---

<html lang="ja">
  <head>
    <BaseHead title={title} description={description} image={heroImage} />
  </head>

  <body>
    <Header />
    <main class="w-full max-w-full m-0 p-4">
      <article>
        <div class="w-full max-w-4xl mx-auto">
          {
            heroImage && (
              <Image
                width={1020}
                height={510}
                src={heroImage}
                alt=""
                class="blockrounded-xl aspect-video object-cover"
              />
            )
          }
        </div>
        <div class="prose max-w-4xl mx-auto text-slate-700">
          <div class="mb-4 py-4 text-center leading-none">
            <div class="mb-2 text-slate-500">
              <FormattedDate date={pubDate} />
              {
                updatedDate && (
                  <div class="italic">
                    Last updated on <FormattedDate date={updatedDate} />
                  </div>
                )
              }
            </div>
            <h1 class="m-0 mb-2">{title}</h1>
            <div class="flex flex-wrap justify-center gap-4 mt-4">
              {
                authors.map((author) => (
                  <a
                    href={`/authors/${author.data.id}/`}
                    class="flex items-center gap-2 py-2 px-4 bg-gray-100 rounded-full no-underline border-2 border-transparent transition-all duration-200 hover:bg-white hover:-translate-y-0.5 hover:shadow-md hover:border-accent"
                  >
                    <Image
                      class="w-8 h-8 rounded-full object-cover"
                      src={author.data.icon}
                      alt={author.data.displayName}
                      width={32}
                      height={32}
                    />
                    <span class="text-sm text-slate-700 hover:text-slate-900">
                      {author.data.displayName}
                    </span>
                  </a>
                ))
              }
            </div>
            {
              tags && tags.length > 0 && (
                <div class="flex flex-wrap justify-center gap-2 mt-4">
                  {tags.map((tag) => (
                    <TagBadge tag={tag} size="md" />
                  ))}
                </div>
              )
            }
            <hr class="mt-4" />
          </div>
          <slot />
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>
