---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a">;

const { href, class: className, ...props } = Astro.props;

const isActive = Astro.url.pathname.startsWith(href?.toString() ?? "");
---

<a
  href={href}
  class:list={[
    "inline-block py-4 px-2 text-slate-700 no-underline border-b-2 border-transparent transition-colors duration-200",
    { "border-accent font-bold": isActive },
    "hover:border-accent",
    className,
  ]}
  {...props}
>
  <slot />
</a>
